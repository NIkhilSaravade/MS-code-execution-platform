# Copy to .env and fill in real values. .env is gitignored - never commit it.

# Postgres (shared instance, one DB per service - see infra/postgres/init-multiple-databases.sh)
POSTGRES_PASSWORD=postgres

# Per-service DB roles: "owner" has DDL rights on its own DB only (used by
# Flyway), "app" is DML-only (used by the running service). Rotate all of
# these before any real deployment.
USER_SERVICE_DB_OWNER_PASSWORD=user-service-owner-dev-secret
USER_SERVICE_DB_APP_PASSWORD=user-service-app-dev-secret
AUTH_SERVICE_DB_OWNER_PASSWORD=auth-service-owner-dev-secret
AUTH_SERVICE_DB_APP_PASSWORD=auth-service-app-dev-secret
PROBLEM_SERVICE_DB_OWNER_PASSWORD=problem-service-owner-dev-secret
PROBLEM_SERVICE_DB_APP_PASSWORD=problem-service-app-dev-secret
SUBMISSION_SERVICE_DB_OWNER_PASSWORD=submission-service-owner-dev-secret
SUBMISSION_SERVICE_DB_APP_PASSWORD=submission-service-app-dev-secret
EXECUTION_RESULT_SERVICE_DB_OWNER_PASSWORD=execution-result-service-owner-dev-secret
EXECUTION_RESULT_SERVICE_DB_APP_PASSWORD=execution-result-service-app-dev-secret
# ai_analysis_db has no separate app role (Python/SQLAlchemy, no Flyway-equivalent
# migration tool set up yet) - the service connects as the owner directly.
AI_ANALYSIS_DB_OWNER_PASSWORD=ai-analysis-owner-dev-secret

# MinIO (S3-compatible storage for test-case content)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# auth-service: bootstrap ADMIN account (see user-service's AdminBootstrap)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Client-credentials secret shared between auth-service and worker-service-go
WORKER_SERVICE_CLIENT_SECRET=dev-only-secret-change-me

# config-service: GitHub PAT for the private centralized-config repo.
# Required - config-service won't start without it. Nothing else in the
# stack currently depends on config-service, so this only blocks that one
# service if you don't have/need it.
GITHUB_PASSWORD=

# ai-analysis-service: Groq API key for langchain-groq (real external secret,
# no safe default exists). Required - ai-analysis-service won't start without it.
GROQ_API_KEY=

# Kafka SASL/PLAIN credentials, one per client identity (see infra/kafka/acls.sh
# for what each one is allowed to do - least privilege per service).
# The admin password itself lives in infra/kafka/kafka_server_jaas.conf and
# infra/kafka/admin-client.properties (not env-driven yet - see Phase 4/Vault
# follow-up). Rotate all of these before any real deployment.
KAFKA_WORKER_PASSWORD=worker-dev-secret
KAFKA_SUBMISSION_SERVICE_PASSWORD=submission-service-dev-secret
KAFKA_EXECUTION_RESULT_SERVICE_PASSWORD=execution-result-service-dev-secret
